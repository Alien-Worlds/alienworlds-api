# Do not install optional dependencies. mongodb 4.x declares the AWS SDK
# credential providers (about 20 packages) and saslprep as optional; they only
# serve MongoDB-on-AWS auth and non-ASCII SCRAM passwords, which this app does
# not use. They stay listed in yarn.lock but are never fetched or installed.
# The Dockerfiles do not copy this file, so they pass --ignore-optional too.
ignore-optional true
